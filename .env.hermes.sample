# Hermes-only configuration. Copy to .env.hermes; Copilot .env is never read.
# No credentials, bearer tokens, Google grants or WhatsApp keys belong here.
HERMES_SUBSCRIPTION_ID=
HERMES_TENANT_ID=
HERMES_OWNER_OBJECT_ID=
HERMES_LOCATION=swedencentral
HERMES_RESOURCE_GROUP=rg-hermes-sandbox
HERMES_SANDBOX_GROUP=hermes-sandbox-group
HERMES_SANDBOX_NAME=hermes-personal
HERMES_DISK_NAME=hermes-image
HERMES_VOLUME_NAME=hermes-data

# Supply an existing PUBLIC image pinned by @sha256; no image is published here.
HERMES_IMAGE=

# Existing inference deployment only. This project never creates models or RBAC.
HERMES_FOUNDRY_ENDPOINT=
HERMES_FOUNDRY_DEPLOYMENT=
HERMES_FOUNDRY_API_MODE=chat_completions
HERMES_FOUNDRY_CONTEXT_LENGTH=
HERMES_FOUNDRY_SCOPE=https://ai.azure.com/.default

# E.164 owner number; only self-chat is supported.
HERMES_WHATSAPP_PHONE=
HERMES_GOOGLE_ENABLED=false
HERMES_GOOGLE_EXPECTED_EMAIL=
HERMES_GOOGLE_CALENDAR_IDS=primary

# Exact hosts ONLY, after verifying the MI path and the pinned bridge's traffic.
# Deployment is gated: the service rejected Partial+Deny. Full+Deny remains
# an unresolved experimental candidate; see docs/hermes.md.
HERMES_IDENTITY_HOST=
HERMES_WHATSAPP_HOSTS=
